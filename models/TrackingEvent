const mongoose = require('mongoose');

const trackingEventSchema = new mongoose.Schema({
  campaignId: {
    type: mongoose.Schema.Types.ObjectId,
    ref: 'Campaign',
    required: true,
    index: true
  },
  recipientEmail: {
    type: String,
    required: true,
    index: true
  },
  eventType: {
    type: String,
    required: true,
    enum: ['open', 'click', 'bounce', 'unsubscribe', 'spam_complaint'],
    index: true
  },
  timestamp: {
    type: Date,
    default: Date.now,
    index: true
  },
  details: {
    type: String,
    default: null // For storing clicked URLs or other event-specific data
  },
  userAgent: {
    type: String,
    default: null
  },
  ipAddress: {
    type: String,
    default: null
  },
  location: {
    country: String,
    city: String,
    region: String
  },
  device: {
    type: String,
    default: null // mobile, desktop, tablet
  },
  browser: {
    type: String,
    default: null
  },
  os: {
    type: String,
    default: null
  }
}, {
  timestamps: true
});

// Compound indexes for better query performance
trackingEventSchema.index({ campaignId: 1, eventType: 1 });
trackingEventSchema.index({ campaignId: 1, recipientEmail: 1 });
trackingEventSchema.index({ campaignId: 1, timestamp: -1 });
trackingEventSchema.index({ recipientEmail: 1, eventType: 1 });

// Virtual for getting readable timestamp
trackingEventSchema.virtual('readableTimestamp').get(function() {
  return this.timestamp.toLocaleDateString() + ' ' + this.timestamp.toLocaleTimeString();
});

// Static method to get analytics for a campaign
trackingEventSchema.statics.getCampaignAnalytics = async function(campaignId) {
  const pipeline = [
    { $match: { campaignId: mongoose.Types.ObjectId(campaignId) } },
    {
      $group: {
        _id: {
          eventType: '$eventType',
          recipientEmail: '$recipientEmail'
        },
        count: { $sum: 1 },
        firstEvent: { $min: '$timestamp' },
        lastEvent: { $max: '$timestamp' }
      }
    },
    {
      $group: {
        _id: '$_id.eventType',
        uniqueRecipients: { $sum: 1 },
        totalEvents: { $sum: '$count' },
        events: {
          $push: {
            email: '$_id.recipientEmail',
            count: '$count',
            firstEvent: '$firstEvent',
            lastEvent: '$lastEvent'
          }
        }
      }
    }
  ];

  return await this.aggregate(pipeline);
};

// Static method to get time-based analytics
trackingEventSchema.statics.getTimeBasedAnalytics = async function(campaignId, hours = 24) {
  const startTime = new Date(Date.now() - hours * 60 * 60 * 1000);
  
  const pipeline = [
    {
      $match: {
        campaignId: mongoose.Types.ObjectId(campaignId),
        timestamp: { $gte: startTime }
      }
    },
    {
      $group: {
        _id: {
          eventType: '$eventType',
          hour: { $hour: '$timestamp' },
          date: { $dateToString: { format: '%Y-%m-%d', date: '$timestamp' } }
        },
        count: { $sum: 1 }
      }
    },
    {
      $sort: { '_id.date': 1, '_id.hour': 1 }
    }
  ];

  return await this.aggregate(pipeline);
};

// Static method to get recipient engagement summary
trackingEventSchema.statics.getRecipientEngagement = async function(campaignId) {
  const pipeline = [
    { $match: { campaignId: mongoose.Types.ObjectId(campaignId) } },
    {
      $group: {
        _id: '$recipientEmail',
        events: {
          $push: {
            eventType: '$eventType',
            timestamp: '$timestamp',
            details: '$details'
          }
        },
        totalEvents: { $sum: 1 },
        hasOpened: {
          $sum: {
            $cond: [{ $eq: ['$eventType', 'open'] }, 1, 0]
          }
        },
        hasClicked: {
          $sum: {
            $cond: [{ $eq: ['$eventType', 'click'] }, 1, 0]
          }
        },
        openCount: {
          $sum: {
            $cond: [{ $eq: ['$eventType', 'open'] }, 1, 0]
          }
        },
        clickCount: {
          $sum: {
            $cond: [{ $eq: ['$eventType', 'click'] }, 1, 0]
          }
        },
        lastActivity: { $max: '$timestamp' }
      }
    },
    {
      $addFields: {
        engagementLevel: {
          $switch: {
            branches: [
              { case: { $gt: ['$hasClicked', 0] }, then: 'high' },
              { case: { $gt: ['$hasOpened', 0] }, then: 'medium' },
              { case: { $eq: ['$totalEvents', 0] }, then: 'none' }
            ],
            default: 'low'
          }
        }
      }
    },
    {
      $sort: { lastActivity: -1 }
    }
  ];

  return await this.aggregate(pipeline);
};

module.exports = mongoose.models.TrackingEvent || mongoose.model('TrackingEvent', trackingEventSchema);
